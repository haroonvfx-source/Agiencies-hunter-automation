# Copy this file to .env (and never commit the real .env) for local runs.
# In GitHub Actions, set these as encrypted repo Secrets instead — see the
# workflow file at .github/workflows/daily_lead_hunt.yml

# Required — Google Sheets output
SPREADSHEET_ID=your_google_sheet_id_here
GOOGLE_SHEETS_CREDENTIALS_JSON={"type": "service_account", "...": "...paste full JSON key here..."}

# Optional — only if you want the Google Custom Search fallback on top of
# the free DuckDuckGo search (not required to run the automation)
GOOGLE_API_KEY=
GOOGLE_CSE_ID=
